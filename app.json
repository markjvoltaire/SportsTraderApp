{
  "expo": {
    "name": "Scoretrade",
    "slug": "scoretrade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ScoretradeBlack.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/sportsIcons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "black"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.markjvoltaire.SportsTraderApp"
    },
    "scheme": "scoretrade",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
